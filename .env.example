# Default provider is gemini (see config.yml llm.provider)
GOOGLE_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here

# ── Dashboard auth ────────────────────────────────────────────────
# When set, all /api/* routes (except /api/auth/*, /api/events/*,
# /api/health, and /api/status) require either an
# `Authorization: Bearer <secret>` header or the `auth` cookie set
# by POSTing the same secret to /api/auth/login. Leave unset to keep
# the dashboard wide open (single-user local-dev case).
# DASHBOARD_AUTH_SECRET=change-me

# When set, /api/events/* (Java plugin → API relay) requires the
# `X-Plugin-Token: <token>` header. Leave unset to keep the legacy
# wide-open behavior.
# PLUGIN_AUTH_TOKEN=plugin-shared-secret

# ── Security alerts ───────────────────────────────────────────────
# When set, impersonation incidents (someone logging in under a bot's
# username) are POSTed to this URL as a Discord-compatible `{content}`
# JSON payload. Works with Discord/Slack-style incoming webhooks. Leave
# unset to disable outbound alerting (dashboard + log still fire).
# IMPERSONATION_ALERT_WEBHOOK=https://discord.com/api/webhooks/xxx/yyy

# ── FleetCraft game-layer bridge ─────────────────────────────────
# Optional. Both values are required to enable the fail-open bridge. The URL
# points to FleetCraft's sidecar (not the Minecraft server), and the key must
# match FleetCraft's SIDECAR_API_KEY. Never expose this key to game clients.
# FLEETCRAFT_URL=http://127.0.0.1:3000
# FLEETCRAFT_API_KEY=replace-with-shared-sidecar-key
# FLEETCRAFT_TIMEOUT_MS=3000
# FLEETCRAFT_SYNC_INTERVAL_MS=30000
