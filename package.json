    "@babel/generator": "^7.29.1",
    "@babel/parser": "^7.29.2",
    "@babel/traverse": "^7.29.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/multer": "^2.1.0",
    "better-sqlite3": "^12.10.0",
    "canvas": "^3.2.3",
