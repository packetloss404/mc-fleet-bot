# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
# ANCHORED with a leading slash — deliberately. Unanchored `build/` matches at
# ANY depth, and it silently shadowed `mcwb/build/`, a real source subpackage
# (7 modules: writer, diff, phase_runner, phase_generator, litematic_writer,
# amulet_writer). Those files were never tracked, so the standalone
# mc-world-builder repo on GitHub was incomplete for its entire life and
# `import mcwb.build` failed on any fresh clone. Recovered 2026-08-07 during
# the subtree merge into mc-fleet-bot. Keep the slashes.
/build/
/dist/
.venv/
venv/
.env

# pytest
.pytest_cache/
.coverage
htmlcov/

# mypy / ruff
.mypy_cache/
.ruff_cache/

# IDE
.idea/
.vscode/
*.swp
*.swo

# mcwb local state
.mcwb-state.json
.mcwb-cache/

# build output
out/
build-output/
*.litematic
*.schem
*.schematic

# test fixtures — keep the briefs, ignore bulky binary blobs
tests/fixtures/**/overhead-map-same-world.png
